# Dev only. Loaded when the app runs as `electron .`; packaged builds ignore
# this file and always use the production hosts in src/shared/constants.js.

INTERVIEW_FRONTEND_BASE_URL=

API_BASE_URL=

# Set to true to dock DevTools on the right at launch and allow F12 /
# Ctrl+Shift+I in dev. Accepts true or 1; anything else is off.
DEVTOOLS=true
