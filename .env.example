# Read from the repo root in dev, and from beside the executable in a packaged
# build — where the release workflow writes it. Both hosts are required; there
# is no built-in fallback.

INTERVIEW_FRONTEND_BASE_URL=

API_BASE_URL=

# Set to true to dock DevTools on the right at launch and allow F12 /
# Ctrl+Shift+I in dev. Accepts true or 1; anything else is off.
DEVTOOLS=true

# Optional. An https link for the help button on the security check; hidden when empty.
SUPPORT_URL=

# Optional. A support address the interview site can show beside the help link.
SUPPORT_EMAIL=

# Optional. API path for a per-company blocklist policy, e.g. /interview/preflight/policy.
PREFLIGHT_POLICY_PATH=

# Optional. API path that receives anonymous security-check results, e.g. /interview/preflight/telemetry.
PREFLIGHT_TELEMETRY_PATH=
