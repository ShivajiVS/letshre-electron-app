{
  "name": "letshyre-secure-interview",
  "version": "1.3.6",
  "description": "LetsHyre Secure Interview Application",
  "main": "main.js",
  "author": "LetsHyre",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch src --watch assets --watch preload.js --ext js,html,css --exec \"electron .\"",
    "clean": "node scripts/clean.js",
    "build:agent": "python scripts/build_agent.py",
    "build:full": "pnpm run build:agent && electron-builder",
    "dist": "node scripts/check-agent-freshness.js && electron-builder",
    "dist:win": "node scripts/check-agent-freshness.js --target=win && electron-builder --win",
    "dist:mac": "node scripts/check-agent-freshness.js --target=mac && electron-builder --mac",
    "test": "node --test --require ./test/_setup.js test/*.test.js",
    "lint": "eslint src scripts test assets/js preload.js preload-recorder.js main.js --ext .js",
    "lint:fix": "eslint src scripts test assets/js preload.js preload-recorder.js main.js --ext .js --fix",
    "format": "prettier --write \"{src,scripts,test}/**/*.js\" \"assets/**/*.{html,css,js}\" \"preload.js\" \"preload-recorder.js\" \"main.js\"",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.js\" \"assets/**/*.{html,css,js}\" \"preload.js\" \"preload-recorder.js\" \"main.js\""
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.letshyre.secure",
    "productName": "LetsHyre Secure Interview",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "ShivajiVS",
        "repo": "letshre-electron-app",
        "releaseType": "draft"
      }
    ],
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "extraFiles": [
      ".env"
    ],
    "extraResources": [
      {
        "from": "resources/agent.exe",
        "to": "agent.exe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-recorder.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/.cache"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "protocols": [
      {
        "name": "LetsHyre Protocol",
        "schemes": [
          "letshyre"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LetsHyre Secure Interview",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/agent",
          "to": "agent",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
